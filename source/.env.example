# Defaults (nothing set) = private preview: noindex, form validates locally, nothing is sent.
# Public release needs ALL of: SITE_MODE=public, SITE_URL (approved HTTPS origin), and every approval in content/launch-config.json.
# These variables are read at BUILD time for static pages — set them for the build, not only at runtime.
SITE_MODE=preview
SITE_URL=

# Live enquiry form (server-only; never prefix with NEXT_PUBLIC_). Requires ENQUIRY_MODE=live AND a public-ready release.
ENQUIRY_MODE=preview
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Test only (ignored/refused when the release is public-ready):
# ENQUIRY_TRANSPORT=mock
# LAUNCH_CONFIG_PATH=qa/fixtures/launch-config.public.json
